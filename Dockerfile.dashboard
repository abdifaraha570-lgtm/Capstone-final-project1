# Streamlit stakeholder + monitoring dashboard (Module 5 + Final Project monitoring page)
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY module5/requirements.txt module5/requirements.txt
RUN pip install --no-cache-dir -r module5/requirements.txt
COPY module5 module5
COPY monitoring monitoring
COPY module4/outputs/model module4/outputs/model
COPY retrain.py retrain.py
EXPOSE 8501
CMD ["streamlit", "run", "module5/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
